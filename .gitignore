# Local-only scratch: original notebooks, full experiment history, prototypes.
# Not pushed to GitHub — see old/README.md.
old/

# Model checkpoints (tens of GB; see models/README.md for how to regenerate them)
models/*
!models/README.md

# Corpus text and everything derived from it. The paper's limitations section
# states that the source (a single literary work) precludes releasing the raw
# text: excerpts of it survive verbatim in the cleaned corpus, the train/val/
# test splits, and the LMSpell CSVs, so all of those stay local too. Only
# data/dictionaries/ (externally-sourced lexicons + the vocabulary list
# extracted from the corpus, not running text) is released.
# Regenerate locally with `python run_experiments.py --stage clean-corpus`
# onward, from your own copy of the source text.
data/datasets/campidanese.tsv
data/datasets/campidanese_cleaned.txt
data/training/train_corpus.txt
data/training/val_corpus.txt
data/training/test_corpus.txt
data/training/trainLMSpell.csv
data/training/valLMSpell.csv
data/training/testLMSpell.csv

# Per-sentence evaluation detail CSVs (regenerated by evaluate_*/grid_search
# scripts; only the summary rows in runs/records/ are versioned) and the full
# grid-search sweep — same reasoning.
runs/details/

# Verbose run logs (nohup/background-run output). Not experiment results —
# those live in runs/records/ — just raw stdout, regenerated on every run.
logs/

# Unsloth's JIT-compiled kernel cache — a local build artifact, regenerated
# automatically the first time an LLM stage runs.
unsloth_compiled_cache/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Environments
.venv/
venv/
.env

# Claude Code local session settings (machine-specific permission grants, not
# part of the project).
.claude/

# OS
.DS_Store
Thumbs.db
